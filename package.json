{
  "name": "ads-config-builder",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "npm run schema && vite",
    "build": "npm run schema && vite build",
    "preview": "vite preview",
    "gen": "node tools/gen-schema.mjs",
    "check:schema": "node tools/check-schema.mjs",
    "schema": "npm run gen && npm run check:schema",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "smol-toml": "^1.4.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
